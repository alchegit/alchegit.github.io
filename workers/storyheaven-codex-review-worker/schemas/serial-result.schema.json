{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "inputHash", "jobType", "resultJson"],
  "properties": {
    "jobId": { "type": "string", "minLength": 1, "maxLength": 36 },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jobType": {
      "type": "string",
      "enum": ["concept_gate", "build_bible", "build_arc", "build_episode_card", "write_draft", "editorial_review", "rewrite_draft"]
    },
    "resultJson": {
      "type": "string",
      "minLength": 2,
      "maxLength": 220000,
      "description": "A JSON-encoded object that follows the job-specific result contract in the prompt."
    }
  }
}
