{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputHash",
          "decision",
          "score",
          "confidence",
          "categories",
          "reason",
          "needsEscalation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 36 },
          "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "decision": { "type": "string", "enum": ["approved", "changes_required"] },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "categories": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_-]{2,40}$" }
          },
          "reason": { "type": "string", "maxLength": 1000 },
          "needsEscalation": { "type": "boolean" }
        }
      }
    }
  }
}
