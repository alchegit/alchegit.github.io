ORACLE_API_BASE_URL=https://replace-with-current-quick-tunnel.trycloudflare.com
WEBTOON_WORKER_TOKEN=replace_with_the_existing_long_worker_token

STORYHEAVEN_REVIEW_WORKER_ID=eetna-web-hoon-01
STORYHEAVEN_REVIEW_BATCH_SIZE=10
STORYHEAVEN_REVIEW_REQUEST_MAX_CHARACTERS=24000
STORYHEAVEN_REVIEW_REQUEST_MAX_ITEMS=6
STORYHEAVEN_REVIEW_POLL_MS=10000
STORYHEAVEN_REVIEW_POLL_MAX_MS=60000
STORYHEAVEN_REVIEW_REQUEST_TIMEOUT_MS=30000
STORYHEAVEN_CODEX_TIMEOUT_MS=180000
STORYHEAVEN_REVIEW_STATE_DIR=/var/lib/neokim-storyheaven-review/runtime
STORYHEAVEN_REVIEW_WORKSPACE=/var/lib/neokim-storyheaven-review/workspace

CODEX_BINARY=/usr/local/bin/codex
CODEX_PRIMARY_MODEL=gpt-5.6-luna
CODEX_SECONDARY_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=low
CODEX_ESCALATE_CONFIDENCE_BELOW=80
CODEX_ESCALATE_APPROVAL_SCORE_BELOW=75

# The serial engine uses the same private worker token but a separate queue.
# Enable only after the matching Oracle migration and API are deployed.
STORYHEAVEN_SERIAL_ENGINE_ENABLED=false
STORYHEAVEN_SERIAL_CODEX_TIMEOUT_MS=480000
CODEX_SERIAL_WRITER_MODEL=gpt-5.6-terra
CODEX_SERIAL_EDITOR_MODEL=gpt-5.6-luna
CODEX_SERIAL_REASONING_EFFORT=medium
